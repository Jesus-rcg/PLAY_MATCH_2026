<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <!-- TITULO -->

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽ PLAYMATCH"
                android:textColor="#0B6E4F"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginTop="20dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo Equipo"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="36sp"
                android:layout_marginTop="20dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crea un equipo para el torneo"
                android:textColor="#7A7A7A"
                android:textSize="15sp"
                android:layout_marginBottom="30dp"/>

        <!-- CARD -->

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:elevation="10dp">

            <!-- NOMBRE -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del equipo"
                    android:textColor="#0B6E4F"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

            <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:hint="Ejemplo: Real Bogotá"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:padding="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="24dp"/>

            <!-- ENTRENADOR -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entrenador"
                    android:textColor="#0B6E4F"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

            <EditText
                    android:id="@+id/etEntrenador"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:hint="Nombre entrenador"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:padding="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="32dp"/>

            <!-- BOTON -->

            <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="GUARDAR EQUIPO"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0B6E4F"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>